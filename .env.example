DATABASE_URL="postgres://prisma.[PROJECT-REF]:[PRISMA-PASSWORD]@[DB-REGION].pooler.supabase.com:6543/postgres"
DIRECT_URL="postgres://postgres.[PROJECT-REF]:[DATABASE-PASSWORD]@[DB-REGION].pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[publishable-key]"
SUPABASE_SECRET_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Seed expects this Supabase Auth user to already exist.
SEED_SA_AUTH_USER_ID="00000000-0000-0000-0000-000000000000"
SEED_SA_EMAIL="admin@example.com"
SEED_SA_DISPLAY_NAME="System Admin"
SEED_SA_PASSWORD=""

# Optional Phase 3 E2E /app scope verification.
# Prefer a dedicated Supabase Auth test user without an app profile.
PHASE3_APP_EMAIL=""
PHASE3_APP_PASSWORD=""

# Fallback for local verification only. Set to "1" to let
# scripts/verify-phase3-app-scope.mjs temporarily change the seed SA app profile
# to MANAGER, run the /app scope check, and restore the profile in cleanup.
PHASE3_ALLOW_SEED_SA_ROLE_FLIP="0"
